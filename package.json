{
  "name": "islandiq",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "wrangler dev --port 8788",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && npm run api",
    "test": "vitest run",
    "schedule": "python3 scripts/build_schedule.py content/questions.xlsx data/schedule.json",
    "db:migrate:local": "wrangler d1 migrations apply islandiq --local",
    "db:migrate:remote": "wrangler d1 migrations apply islandiq --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wrangler": "^4.30.0"
  },
  "dependencies": {
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0"
  }
}
